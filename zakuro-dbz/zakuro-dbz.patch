+//! prueba: une dos jugadores a una sala del servidor y muestra los miembros.
+use zakuro_core::room::Connection;
+fn main() {
+    let address = std::env::args().nth(1).unwrap_or("127.0.0.1:24873".into());
+    let a = Connection::join(&address, "Goku", "").expect("join a");
+    let b = Connection::join(&address, "Vegeta", "").expect("join b");
+    a.playing("DBZ: Extreme Butoden");
+    std::thread::sleep(std::time::Duration::from_millis(600));
+    println!("sala: {}  miembros vistos por B: {:?}", b.room(), b.members().iter().map(|m| (&m.nickname, &m.game)).collect::<Vec<_>>());
+    let (la, lb) = (a.link(), b.link());
+    la.send(lb.mac(), b"kamehameha".to_vec());
+    std::thread::sleep(std::time::Duration::from_millis(400));
+    println!("B recibe: {:?}", lb.receive().iter().map(|(_, body)| String::from_utf8_lossy(body).into_owned()).collect::<Vec<_>>());
+    std::thread::sleep(std::time::Duration::from_secs(3));
+}
diff --git a/crates/ef-servidor/src/main.rs b/crates/ef-servidor/src/main.rs
new file mode 100644
index 0000000..849fbca
--- /dev/null
+++ b/crates/ef-servidor/src/main.rs
@@ -0,0 +1,121 @@
+//! Extreme Fighters: servidor de salas online.
+//!
+//! Mantiene abiertas varias salas de Zakuro (las mismas que abre un jugador
+//! desde "Online") y publica su lista para que el juego la muestre y cada
+//! uno se una con un clic. Como todos se conectan a este servidor, los
+//! jugadores no tienen que abrir puertos en su router: solo este equipo.
+//!
+//! Uso:
+//!   ef-servidor [--salas 6] [--puerto 24873] [--puerto-lista 24872]
+//!               [--nombre "Sala"] [--jugadores 2] [--contrasena ""]
+//!
+//! Abre las salas en los puertos 24873, 24874, ... y la lista en 24872.
+//! En el router o el cortafuegos del servidor hay que dejar pasar esos
+//! puertos TCP. La lista se puede ver en el navegador: http://IP:24872/
+
+use std::io::{Read, Write};
+use std::net::{TcpListener, TcpStream};
+use std::time::Duration;
+
+use zakuro_core::room::{Server, DEFAULT_PORT};
+
+/// la primera linea de la lista, para que el juego sepa que es un servidor
+/// de Extreme Fighters y de que version.
+const HEADER: &str = "EXTREME-FIGHTERS-SALAS 1";
+
+struct Options {
+    rooms: usize,
+    port: u16,
+    list_port: u16,
+    name: String,
+    most: usize,
+    password: String,
+}
+
+fn options() -> Result<Options, String> {
+    let mut options = Options { rooms: 6, port: DEFAULT_PORT, list_port: DEFAULT_PORT - 1, name: "Sala".into(), most: 2, password: String::new() };
+    let mut args = std::env::args().skip(1);
+    while let Some(arg) = args.next() {
+        let mut value = || args.next().ok_or(format!("{arg} necesita un valor"));
+        match arg.as_str() {
+            "--salas" => options.rooms = value()?.parse().map_err(|_| "--salas: numero no valido")?,
+            "--puerto" => options.port = value()?.parse().map_err(|_| "--puerto: numero no valido")?,
+            "--puerto-lista" => options.list_port = value()?.parse().map_err(|_| "--puerto-lista: numero no valido")?,
+            "--nombre" => options.name = value()?,
+            "--jugadores" => options.most = value()?.parse().map_err(|_| "--jugadores: numero no valido")?,
+            "--contrasena" => options.password = value()?,
+            "-h" | "--help" | "--ayuda" => {
+                println!("ef-servidor [--salas 6] [--puerto 24873] [--puerto-lista 24872] [--nombre Sala] [--jugadores 2] [--contrasena X]");
+                std::process::exit(0);
+            }
+            other => return Err(format!("opcion desconocida: {other}")),
+        }
+    }
+    options.rooms = options.rooms.clamp(1, 64);
+    options.most = options.most.clamp(2, 16);
+    Ok(options)
+}
+
+/// un texto sin tabuladores ni saltos de linea, que separan los campos.
+fn field(text: &str) -> String {
+    text.chars().map(|c| if c == '\t' || c == '\n' || c == '\r' { ' ' } else { c }).collect()
+}
+
+fn answer(mut stream: TcpStream, rooms: &[(String, Server)], most: usize) {
+    let _ = stream.set_read_timeout(Some(Duration::from_secs(3)));
+    let _ = stream.set_write_timeout(Some(Duration::from_secs(3)));
+    // la peticion no importa, solo se lee para no cortar al que la envia
+    let mut request = [0u8; 2048];
+    let _ = stream.read(&mut request);
+    let mut body = format!("{HEADER}\n");
+    for (name, server) in rooms {
+        let members = server.members();
+        let game = members.iter().map(|member| member.game.as_str()).find(|game| !game.is_empty()).unwrap_or("");
+        body.push_str(&format!("{}\t{}\t{}\t{}\t{}\n", server.port(), members.len(), most, field(name), field(game)));
+    }
+    let response = format!(
+        "HTTP/1.0 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: {}\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n{body}",
+        body.len()
+    );
+    let _ = stream.write_all(response.as_bytes());
+}
+
+fn main() {
+    env_logger::Builder::from_env(env_logger::Env::default().default_filter_or("info")).init();
+    let options = match options() {
+        Ok(options) => options,
+        Err(error) => {
+            eprintln!("{error}");
+            std::process::exit(2);
+        }
+    };
+    let mut rooms = Vec::new();
+    for i in 0..options.rooms {
+        let name = format!("{} {}", options.name, i + 1);
+        let port = options.port + i as u16;
+        match Server::start(port, &name, &options.password, options.most) {
+            Ok(server) => rooms.push((name, server)),
+            Err(error) => {
+                eprintln!("no se pudo abrir la sala {name} en el puerto {port}: {error}");
+                std::process::exit(1);
+            }
+        }
+    }
+    let listener = match TcpListener::bind(("0.0.0.0", options.list_port)) {
+        Ok(listener) => listener,
+        Err(error) => {
+            eprintln!("no se pudo abrir la lista en el puerto {}: {error}", options.list_port);
+            std::process::exit(1);
+        }
+    };
+    let last = options.port + options.rooms as u16 - 1;
+    println!("Extreme Fighters - servidor de salas");
+    println!("  {} salas de hasta {} jugadores, puertos {}-{}", options.rooms, options.most, options.port, last);
+    println!("  lista en el puerto {}  (http://<tu IP>:{}/)", options.list_port, options.list_port);
+    println!("  Deja pasar los puertos TCP {}-{} en el router o cortafuegos.", options.list_port, last);
+    println!("  En el juego: Online > Salas publicas > Servidor: <tu IP o dominio>");
+    println!("  Ctrl+C para cerrar.");
+    for stream in listener.incoming().flatten() {
+        answer(stream, &rooms, options.most);
+    }
+}
