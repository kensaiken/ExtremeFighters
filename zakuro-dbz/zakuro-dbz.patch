+//! DBZ Extreme Butoden edition: the menus in the language the installer
+//! chose (settings.ui_language). Text missing from the table stays in
+//! English.
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+/// 0 English, then the columns of TABLE: es, fr, de, it, ja, zh.
+static LANGUAGE: AtomicUsize = AtomicUsize::new(0);
+
+pub fn set_language(code: &str) {
+    let column = match code {
+        "es" => 1,
+        "fr" => 2,
+        "de" => 3,
+        "it" => 4,
+        "ja" => 5,
+        "zh" => 6,
+        _ => 0,
+    };
+    LANGUAGE.store(column, Ordering::Relaxed);
+}
+
+/// text in the menus' language.
+pub fn t(english: &'static str) -> &'static str {
+    let column = LANGUAGE.load(Ordering::Relaxed);
+    if column == 0 {
+        return english;
+    }
+    TABLE.iter().find(|(key, _)| *key == english).map_or(english, |(_, row)| row[column - 1])
+}
