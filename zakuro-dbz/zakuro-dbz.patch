diff --git a/crates/zakuro/src/lobby.rs b/crates/zakuro/src/lobby.rs
new file mode 100644
index 0000000..d0f816d
--- /dev/null
+++ b/crates/zakuro/src/lobby.rs
@@ -0,0 +1,83 @@
+//! Extreme Fighters: the list of public rooms an Extreme Fighters room
+//! server (ef-servidor) keeps open, so that joining one takes a click.
+
+use std::io::{Read, Write};
+use std::net::{TcpStream, ToSocketAddrs};
+use std::time::Duration;
+
+/// the list's port unless the address says another, the one before rooms'.
+pub const LIST_PORT: u16 = zakuro_core::room::DEFAULT_PORT - 1;
+const HEADER: &str = "EXTREME-FIGHTERS-SALAS";
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct LobbyRoom {
+    pub name: String,
+    /// where to join it, the server's host and the room's port.
+    pub address: String,
+    pub players: usize,
+    pub most: usize,
+    /// the game played in it, empty while nobody plays.
+    pub game: String,
+}
+
+/// the host of an address and its port, the list's when it has none.
+fn split(server: &str) -> (String, u16) {
+    let server = server.trim().trim_start_matches("http://").trim_end_matches('/');
+    if let Some((host, port)) = server.rsplit_once(':').filter(|(host, _)| !host.contains(':') || host.starts_with('[')) {
+        if let Ok(port) = port.parse() {
+            return (host.to_owned(), port);
+        }
+    }
+    (server.to_owned(), LIST_PORT)
+}
+
+/// asks the server at address for its rooms.
+pub fn fetch(server: &str) -> Result<Vec<LobbyRoom>, String> {
+    let (host, port) = split(server);
+    if host.is_empty() {
+        return Err("no server".into());
+    }
+    let address = (host.as_str(), port).to_socket_addrs().map_err(|error| error.to_string())?.next().ok_or("no address")?;
+    let mut stream = TcpStream::connect_timeout(&address, Duration::from_secs(5)).map_err(|error| error.to_string())?;
+    stream.set_read_timeout(Some(Duration::from_secs(5))).map_err(|error| error.to_string())?;
+    stream.write_all(format!("GET / HTTP/1.0\r\nHost: {host}\r\n\r\n").as_bytes()).map_err(|error| error.to_string())?;
+    let mut text = String::new();
+    stream.read_to_string(&mut text).map_err(|error| error.to_string())?;
+    let body = text.split_once("\r\n\r\n").map_or(text.as_str(), |(_, body)| body);
+    parse(body, &host)
+}
+
+fn parse(body: &str, host: &str) -> Result<Vec<LobbyRoom>, String> {
+    let mut lines = body.lines();
+    if !lines.next().is_some_and(|first| first.starts_with(HEADER)) {
+        return Err("not an Extreme Fighters room server".into());
+    }
+    Ok(lines
+        .filter_map(|line| {
+            let mut fields = line.split('\t');
+            let port: u16 = fields.next()?.parse().ok()?;
+            let players = fields.next()?.parse().ok()?;
+            let most = fields.next()?.parse().ok()?;
+            let name = fields.next()?.to_owned();
+            let game = fields.next().unwrap_or("").to_owned();
+            Some(LobbyRoom { name, address: format!("{host}:{port}"), players, most, game })
+        })
+        .collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn addresses_and_lists_are_read() {
+        assert_eq!(split("example.com"), ("example.com".into(), LIST_PORT));
+        assert_eq!(split("1.2.3.4:9000"), ("1.2.3.4".into(), 9000));
+        assert_eq!(split("http://example.com:24872/"), ("example.com".into(), 24872));
+        let rooms = parse("EXTREME-FIGHTERS-SALAS 1\n24873\t1\t2\tSala 1\tDBZ\n24874\t0\t2\tSala 2\t\n", "h").unwrap();
+        assert_eq!(rooms.len(), 2);
+        assert_eq!(rooms[0].address, "h:24873");
+        assert_eq!((rooms[0].players, rooms[0].most, rooms[0].game.as_str()), (1, 2, "DBZ"));
+        assert!(parse("hello", "h").is_err());
+    }
+}
