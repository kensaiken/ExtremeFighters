+        }
+        let tap = if self.touch.enabled { self.cards() } else { None };
         if state.touch.is_none() {
-            let held = self.touch_held();
-            if held[0] {
-                state.touch = Some(self.touch.second_at);
-            } else if held[1] {
-                state.touch = Some(self.touch.third_at);
-            }
+            state.touch = tap;
         }
+        let picking = self.picking();
+        let Some(gilrs) = &self.gilrs else { return state };
         for (_, pad) in gilrs.gamepads() {
             for (button, bound) in self.buttons.map() {
-                // a button that touches a card does only that
-                if pad.is_pressed(bound) && !self.touches(&pad, bound) {
+                // a button that touches a card does only that, and with L2
