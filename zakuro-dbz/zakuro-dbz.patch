+/// DBZ edition: the installer's orange.
+pub const ORANGE: egui::Color32 = egui::Color32::from_rgb(255, 160, 30);
+
+/// DBZ edition: the look of the installer, dark panels with orange edges,
+/// bigger text and buttons.
+fn theme(style: &mut egui::Style) {
+    use egui::{Color32, CornerRadius, FontFamily, FontId, Stroke, TextStyle};
+    style.text_styles = [
+        (TextStyle::Small, FontId::new(12.0, FontFamily::Proportional)),
+        (TextStyle::Body, FontId::new(15.5, FontFamily::Proportional)),
+        (TextStyle::Button, FontId::new(16.0, FontFamily::Proportional)),
+        (TextStyle::Heading, FontId::new(21.0, FontFamily::Proportional)),
+        (TextStyle::Monospace, FontId::new(14.0, FontFamily::Monospace)),
+    ]
+    .into();
+    style.spacing.item_spacing = egui::vec2(8.0, 6.0);
+    style.spacing.button_padding = egui::vec2(10.0, 5.0);
+    style.spacing.interact_size.y = 24.0;
+    let v = &mut style.visuals;
+    v.dark_mode = true;
+    v.window_fill = Color32::from_rgba_unmultiplied(20, 17, 16, 244);
+    v.panel_fill = Color32::from_rgb(20, 17, 16);
+    v.window_stroke = Stroke::new(2.0, ORANGE);
+    v.window_corner_radius = CornerRadius::same(10);
+    v.menu_corner_radius = CornerRadius::same(8);
+    v.extreme_bg_color = Color32::from_rgb(12, 11, 12);
+    v.faint_bg_color = Color32::from_rgb(34, 30, 28);
+    v.hyperlink_color = ORANGE;
+    v.selection.bg_fill = Color32::from_rgb(200, 100, 0);
+    v.selection.stroke = Stroke::new(1.5, Color32::WHITE);
+    v.slider_trailing_fill = true;
+    let radius = CornerRadius::same(6);
+    let w = &mut v.widgets;
+    w.noninteractive.bg_stroke = Stroke::new(1.0, Color32::from_rgb(90, 60, 30));
+    w.noninteractive.fg_stroke = Stroke::new(1.0, Color32::from_rgb(232, 232, 236));
+    w.inactive.bg_fill = Color32::from_rgb(52, 50, 56);
+    w.inactive.weak_bg_fill = Color32::from_rgb(52, 50, 56);
+    w.inactive.bg_stroke = Stroke::new(1.0, Color32::from_rgb(110, 105, 112));
+    w.inactive.fg_stroke = Stroke::new(1.0, Color32::WHITE);
+    w.hovered.bg_fill = Color32::from_rgb(235, 120, 10);
+    w.hovered.weak_bg_fill = Color32::from_rgb(235, 120, 10);
+    w.hovered.bg_stroke = Stroke::new(1.5, Color32::from_rgb(255, 220, 130));
+    w.hovered.fg_stroke = Stroke::new(1.5, Color32::BLACK);
+    w.active.bg_fill = Color32::from_rgb(255, 170, 40);
+    w.active.weak_bg_fill = Color32::from_rgb(255, 170, 40);
+    w.active.bg_stroke = Stroke::new(1.5, Color32::WHITE);
+    w.active.fg_stroke = Stroke::new(1.5, Color32::BLACK);
+    w.open.bg_fill = Color32::from_rgb(70, 50, 30);
+    w.open.weak_bg_fill = Color32::from_rgb(70, 50, 30);
+    for widget in [&mut w.noninteractive, &mut w.inactive, &mut w.hovered, &mut w.active, &mut w.open] {
+        widget.corner_radius = radius;
+    }
+}
+
+/// DBZ edition: Windows' Bahnschrift, a condensed font like the
+/// installer's, for the menus' Latin text.
+fn brand_font() -> Option<Vec<u8>> {
+    let windows = std::path::PathBuf::from(std::env::var_os("WINDIR").unwrap_or_else(|| "C:\\Windows".into()));
+    std::fs::read(windows.join("Fonts").join("bahnschrift.ttf")).ok()
+}
+
+/// the fonts, with the first extra one ahead of egui's own when first says
+/// so, the brand font, and the rest after them to fall back on.
+fn fonts_with(extra: Vec<Vec<u8>>, first: bool) -> egui::FontDefinitions {
+    let mut fonts = fonts(extra);
+    if first {
+        for family in [egui::FontFamily::Proportional] {
+            let list = fonts.families.entry(family).or_default();
+            if let Some(at) = list.iter().position(|name| name == "system 0") {
+                let name = list.remove(at);
+                list.insert(0, name);
+            }
+        }
+    }
+    fonts
+}
+
 /// egui's own fonts, then extra ones to fall back on for what they lack.
 /// game names come in Japanese, Korean and Chinese, whose characters
 /// egui's fonts have none of and drew as boxes.
