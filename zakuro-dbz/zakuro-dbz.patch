+/// DBZ Extreme Butoden edition: controller buttons that, held, touch a
+/// point of the bottom screen, the cards of the team's other characters,
+/// which change to them or call them in as strikers.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct TouchButtons {
+    pub enabled: bool,
+    pub second: Button,
+    pub third: Button,
+    /// where each card is touched, in the bottom screen's 320x240 pixels.
+    pub second_at: (u16, u16),
+    pub third_at: (u16, u16),
+}
+
+impl Default for TouchButtons {
+    fn default() -> Self {
+        TouchButtons {
+            enabled: true,
+            second: Button::LeftTrigger2,
+            third: Button::RightTrigger2,
+            second_at: (161, 109),
+            third_at: (266, 109),
+        }
+    }
+}
+
+impl TouchButtons {
+    /// each button that touches, and where.
+    pub fn map(&self) -> Vec<(Button, (u16, u16))> {
+        if !self.enabled {
+            return Vec::new();
+        }
+        vec![(self.second, self.second_at), (self.third, self.third_at)]
+    }
+
+    /// whether button touches a card, rather than doing what it is bound to.
+    pub fn uses(&self, button: Button) -> bool {
