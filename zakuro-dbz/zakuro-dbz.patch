diff --git a/crates/zakuro/src/online.rs b/crates/zakuro/src/online.rs
new file mode 100644
index 0000000..2e8b812
--- /dev/null
+++ b/crates/zakuro/src/online.rs
@@ -0,0 +1,252 @@
+//! Extreme Fighters: online rooms that open the router by themselves
+//! (UPnP), room codes to share instead of addresses, telling when a
+//! connection can't take players (CG-NAT), and checking for new versions.
+
+use std::net::{Ipv4Addr, SocketAddr, SocketAddrV4, TcpStream, UdpSocket};
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+/// the repository whose releases are Extreme Fighters' versions.
+pub const REPOSITORY: &str = "kensaiken/ExtremeFighters";
+
+/// Crockford's base 32, no letters that look like digits.
+const ALPHABET: &[u8; 32] = b"0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+
+/// a room code for an IPv4 address and port: EF-XXXXX-XXXXX, the 48 bits
+/// of both in base 32.
+pub fn encode_code(ip: Ipv4Addr, port: u16) -> String {
+    let value = (u64::from(u32::from(ip)) << 16) | u64::from(port);
+    let digits: String = (0..10).rev().map(|i| ALPHABET[((value >> (i * 5)) & 31) as usize] as char).collect();
+    format!("EF-{}-{}", &digits[..5], &digits[5..])
+}
+
+/// the address a room code stands for, none when it isn't one.
+pub fn decode_code(code: &str) -> Option<String> {
+    let cleaned: String = code.trim().to_ascii_uppercase().chars().filter(|c| c.is_ascii_alphanumeric()).collect();
+    let digits = cleaned.strip_prefix("EF")?;
+    if digits.len() != 10 {
+        return None;
+    }
+    let mut value = 0u64;
+    for c in digits.chars() {
+        // the letters people mistake for digits count as them
+        let c = match c {
+            'O' => '0',
+            'I' | 'L' => '1',
+            c => c,
+        };
+        value = (value << 5) | ALPHABET.iter().position(|&a| a as char == c)? as u64;
+    }
+    let ip = Ipv4Addr::from((value >> 16) as u32);
+    let port = (value & 0xFFFF) as u16;
+    (port != 0 && !ip.is_unspecified()).then(|| format!("{ip}:{port}"))
+}
+
+/// whether an address can't be reached from the internet: private,
+/// CG-NAT's 100.64.0.0/10, loopback or link-local.
+pub fn is_private(ip: Ipv4Addr) -> bool {
+    let [a, b, ..] = ip.octets();
+    ip.is_private() || ip.is_loopback() || ip.is_link_local() || (a == 100 && (64..128).contains(&b))
+}
+
+/// what opening a room to the internet came to.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Reach {
+    /// the router opened the port, the code reaches the room.
+    Open { code: String },
+    /// the router could not be asked, the port has to be opened by hand;
+    /// the code is right once it is.
+    Manual { code: String, port: u16 },
+    /// a router behind another one, the provider's (CG-NAT): nobody from
+    /// the internet can reach this computer.
+    Unreachable,
+    /// no way to tell the address, no internet say.
+    Offline,
+}
+
+/// the address this computer has on the internet, asked of a service that
+/// tells it, through curl, which Windows 10 and later have.
+pub fn public_ip() -> Option<Ipv4Addr> {
+    for url in ["https://api.ipify.org", "https://ifconfig.me/ip", "https://icanhazip.com"] {
+        if let Some(text) = curl(url, 6) {
+            if let Ok(ip) = text.trim().parse() {
+                return Some(ip);
+            }
+        }
+    }
+    None
+}
+
+/// asks the router to let port through to this computer and works out
+/// whether the room can be reached and by which code.
+pub fn open(port: u16) -> Reach {
+    let mapped = map_port(port);
+    let public = public_ip();
+    match (mapped, public) {
+        (Ok(external), Some(public)) if external == public => Reach::Open { code: encode_code(public, port) },
+        // the router's own address is not the internet's: another router,
+        // the provider's, sits in between
+        (Ok(external), Some(_)) if is_private(external) => Reach::Unreachable,
+        (Ok(_), Some(public)) => Reach::Manual { code: encode_code(public, port), port },
+        (Ok(external), None) if !is_private(external) => Reach::Open { code: encode_code(external, port) },
+        (Ok(_), None) => Reach::Unreachable,
+        (Err(error), Some(public)) => {
+            log::info!("the router could not be opened, {error}");
+            Reach::Manual { code: encode_code(public, port), port }
+        }
+        (Err(_), None) => Reach::Offline,
+    }
+}
+
+/// maps port on the router to this computer, returns the router's address
+/// on the outside.
+fn map_port(port: u16) -> Result<Ipv4Addr, String> {
+    let mut options = igd_next::SearchOptions::default();
+    options.timeout = Some(Duration::from_secs(3));
+    let gateway = igd_next::search_gateway(options).map_err(|error| error.to_string())?;
+    let local = local_ip(gateway.addr).ok_or("no local address")?;
+    let external = match gateway.get_external_ip().map_err(|error| error.to_string())? {
+        std::net::IpAddr::V4(ip) => ip,
+        std::net::IpAddr::V6(_) => return Err("the router speaks IPv6 only".into()),
+    };
+    let local = SocketAddr::V4(SocketAddrV4::new(local, port));
+    gateway
+        .add_port(igd_next::PortMappingProtocol::TCP, port, local, 0, "Extreme Fighters")
+        .map_err(|error| error.to_string())?;
+    log::info!("the router lets port {port} through to {local}, outside {external}");
+    Ok(external)
+}
+
+/// takes back what map_port asked of the router.
+pub fn close(port: u16) {
+    let mut options = igd_next::SearchOptions::default();
+    options.timeout = Some(Duration::from_secs(2));
+    if let Ok(gateway) = igd_next::search_gateway(options) {
+        let _ = gateway.remove_port(igd_next::PortMappingProtocol::TCP, port);
+    }
+}
+
+/// this computer's address toward the router.
+fn local_ip(router: SocketAddr) -> Option<Ipv4Addr> {
+    let socket = UdpSocket::bind("0.0.0.0:0").ok()?;
+    socket.connect(router).ok()?;
+    match socket.local_addr().ok()?.ip() {
+        std::net::IpAddr::V4(ip) => Some(ip),
+        std::net::IpAddr::V6(_) => None,
+    }
+}
+
+/// how long connecting to an address takes, in milliseconds.
+pub fn ping(address: &str) -> Option<u32> {
+    use std::net::ToSocketAddrs;
+    let address = address.to_socket_addrs().ok()?.next()?;
+    let start = Instant::now();
+    let stream = TcpStream::connect_timeout(&address, Duration::from_secs(2)).ok()?;
+    let took = start.elapsed().as_millis() as u32;
+    drop(stream);
+    Some(took)
+}
+
+/// the text at url, through curl, none when it fails.
+fn curl(url: &str, seconds: u32) -> Option<String> {
+    let mut command = Command::new("curl");
+    command
+        .args(["-fsSL", "--max-time", &seconds.to_string(), "-A", "ExtremeFighters", "-H", "Accept: application/vnd.github+json", url])
+        .stdin(Stdio::null())
+        .stderr(Stdio::null());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        // no console window flashing up
+        command.creation_flags(0x0800_0000);
+    }
+    let output = command.output().ok().filter(|output| output.status.success())?;
+    String::from_utf8(output.stdout).ok()
+}
+
+/// the folder Extreme Fighters is installed in, the one above Zakuro's.
+pub fn install_dir() -> Option<std::path::PathBuf> {
+    let exe = std::env::current_exe().ok()?;
+    Some(exe.parent()?.parent()?.to_path_buf())
+}
+
+/// the installed version, as the installer wrote it.
+pub fn installed_version() -> Option<String> {
+    let text = std::fs::read_to_string(install_dir()?.join("ef_version.txt")).ok()?;
+    Some(text.trim().trim_start_matches('v').to_owned()).filter(|version| !version.is_empty())
+}
+
+/// a version's numbers, to compare them.
+fn numbers(version: &str) -> Vec<u32> {
+    version.trim().trim_start_matches('v').split(['.', '-']).map_while(|part| part.parse().ok()).collect()
+}
+
+pub fn newer(latest: &str, current: &str) -> bool {
+    numbers(latest) > numbers(current)
+}
+
+/// the latest release's version, asked of GitHub.
+pub fn latest_version() -> Result<String, String> {
+    let text = curl(&format!("https://api.github.com/repos/{REPOSITORY}/releases/latest"), 8).ok_or("GitHub could not be reached")?;
+    let at = text.find("\"tag_name\"").ok_or("no version in the answer")?;
+    let rest = &text[at + "\"tag_name\"".len()..];
+    let start = rest.find('"').ok_or("no version in the answer")? + 1;
+    let end = rest[start..].find('"').ok_or("no version in the answer")? + start;
+    Ok(rest[start..end].trim_start_matches('v').to_owned())
+}
+
+/// what checking for a new version found: the latest version when it is
+/// newer than the one installed.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Update {
+    Available(String),
+    UpToDate,
+    Failed(String),
+}
+
+pub fn check() -> Update {
+    let Some(current) = installed_version() else { return Update::Failed("the installed version is unknown".into()) };
+    match latest_version() {
+        Ok(latest) if newer(&latest, &current) => Update::Available(latest),
+        Ok(_) => Update::UpToDate,
+        Err(error) => Update::Failed(error),
+    }
+}
+
+/// starts the updater of the install folder, which waits for Zakuro to
+/// close, downloads the latest version and installs it.
+pub fn start_updater() -> Result<(), String> {
+    let dir = install_dir().ok_or("no install folder")?;
+    let script = dir.join("actualizar.ps1");
+    if !script.is_file() {
+        return Err("actualizar.ps1 is missing, run the installer again".into());
+    }
+    let mut command = Command::new("powershell.exe");
+    command.args(["-NoProfile", "-ExecutionPolicy", "Bypass", "-STA", "-WindowStyle", "Hidden", "-File"]).arg(&script).arg("-Jugar");
+    command.spawn().map(drop).map_err(|error| error.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn codes_go_both_ways() {
+        let code = encode_code(Ipv4Addr::new(85, 10, 20, 30), 24873);
+        assert_eq!(code.len(), 14);
+        assert_eq!(decode_code(&code).as_deref(), Some("85.10.20.30:24873"));
+        assert_eq!(decode_code(&code.to_lowercase().replace('-', " ")).as_deref(), Some("85.10.20.30:24873"));
+        assert_eq!(decode_code("hello"), None);
+        assert_eq!(decode_code("192.168.0.10:24873"), None);
+    }
+
+    #[test]
+    fn versions_and_addresses() {
+        assert!(newer("0.4.1", "0.4.0"));
+        assert!(newer("v0.10.0", "0.9.9"));
+        assert!(!newer("0.4.0", "0.4.0"));
+        assert!(is_private(Ipv4Addr::new(100, 72, 1, 2)));
+        assert!(is_private(Ipv4Addr::new(192, 168, 1, 2)));
+        assert!(!is_private(Ipv4Addr::new(85, 10, 20, 30)));
+    }
+}
