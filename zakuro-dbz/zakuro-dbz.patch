+    /// Extreme Fighters: works out which card to touch this frame from the
+    /// two controls, and keeps touching it for a short tap, as a finger
+    /// would, however long the control is held.
+    fn cards(&mut self) -> Option<(u16, u16)> {
+        const TAP: u8 = 6;
+        const BOTH: u8 = 5;
+        let held = self.touch_held();
+        let rise = [held[0] && !self.prev_held[0], held[1] && !self.prev_held[1]];
+        self.prev_held = held;
+        let faces = [Button::West, Button::North, Button::East, Button::South];
+        let face_held: [bool; 4] = std::array::from_fn(|i| self.holding(faces[i]));
+        let face_rise: [bool; 4] = std::array::from_fn(|i| face_held[i] && !self.prev_face[i]);
+        self.prev_face = face_held;
+        let mut fire = None;
+        match self.touch.scheme {
+            TouchScheme::Triggers => {
+                // one trigger waits a moment for the other, both are the 4th
+                match (rise, self.waiting) {
+                    ([true, true], _) => fire = Some(2),
+                    ([true, false], Some((1, _))) | ([false, true], Some((0, _))) => fire = Some(2),
+                    ([true, false], _) => self.waiting = Some((0, BOTH)),
+                    ([false, true], _) => self.waiting = Some((1, BOTH)),
+                    _ => {}
+                }
+                if fire.is_some() {
+                    self.waiting = None;
+                } else if let Some((which, left)) = self.waiting {
+                    if left <= 1 {
+                        self.waiting = None;
+                        fire = Some(which);
+                    } else if !rise.iter().any(|&r| r) {
+                        self.waiting = Some((which, left - 1));
+                    }
+                }
+            }
+            TouchScheme::Combo => {
+                if rise[1] {
+                    fire = Some(0);
+                }
+                if held[0] {
+                    if let Some(i) = face_rise.iter().position(|&r| r) {
+                        fire = Some(i);
+                    }
+                }
+            }
+        }
+        if let Some(card) = fire {
+            if let Some(at) = self.touch.cards.get(card).copied().flatten() {
+                self.tap = Some((at, TAP));
+            }
+        }
+        match self.tap {
+            Some((at, left)) => {
+                self.tap = (left > 1).then_some((at, left - 1));
+                Some(at)
+            }
+            None => None,
+        }
+    }
+
+    /// whether the face buttons pick a card now rather than going to the
+    /// game: L2 held in the scheme where it does that.
+    fn picking(&self) -> bool {
+        self.touch.enabled && self.touch.scheme == TouchScheme::Combo && self.touch_held()[0]
+    }
+
