+    /// Extreme Fighters: replaces the running game's save with one the player
+    /// picks, a folder of its files, after copying the current one aside, and
+    /// starts the game again on it.
+    fn import_save(&mut self) {
+        let (Some(dir), Some(id)) = (self.data_dir.clone(), self.program_id()) else {
+            self.menus.message = Some(tr::t("Start the game first, then import the save.").to_owned());
+            return;
+        };
+        let Some(picked) = rfd::FileDialog::new().set_title(tr::t("Choose the folder of the save to import")).pick_folder() else { return };
+        // a Citra save keeps its files in data/00000001 under the title, a
+        // Checkpoint or JKSM backup in the folder itself
+        let from = if picked.join("00000001").is_dir() { picked.join("00000001") } else { picked };
+        let has_files = std::fs::read_dir(&from).map(|entries| entries.flatten().next().is_some()).unwrap_or(false);
+        if !has_files {
+            self.menus.message = Some(tr::t("That folder has no save files.").to_owned());
+            return;
+        }
+        let saves = dir.join("savedata");
+        let target = saves.join(format!("{id:016X}"));
+        let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
+        let backup = saves.join(format!("{id:016X}_copia_{stamp}"));
+        let result = (|| -> std::io::Result<()> {
+            if target.is_dir() {
+                copy_dir(&target, &backup)?;
+                std::fs::remove_dir_all(&target)?;
+            }
+            copy_dir(&from, &target)
+        })();
+        match result {
+            Ok(()) => {
+                log::info!("imported the save from {} into {}", from.display(), target.display());
+                let note = if backup.is_dir() { format!("{}\n{}", tr::t("Save imported. Your previous save was copied to:"), backup.display()) } else { tr::t("Save imported.").to_owned() };
+                self.menus.message = Some(note);
+                if let Some(path) = self.game.as_ref().map(|game| game.path.clone()) {
+                    if let Err(error) = self.play(&path) {
+                        self.menus.message = Some(error);
+                    }
+                }
+            }
+            Err(error) => self.menus.message = Some(format!("{} {error}", tr::t("The save could not be imported:"))),
+        }
+    }
